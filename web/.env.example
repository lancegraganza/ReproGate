# ReproGate supports local Quickstart and Testnet only. Mainnet is rejected in code.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_REPRO_REGISTRY_CONTRACT_ID=CAH5OSI255VRSJJQVM6JCR77E5C52IB7Y6WCNZYVC3DH7MDSVMRLHMVI
NEXT_PUBLIC_REWARD_VAULT_CONTRACT_ID=CDDE25PTGG2XOTQHJ25CIQRUBJ6I6Q4WLIIWSURLLWP26B5HKABWNU5E

# Optional for higher GitHub API limits and posting the final issue report.
GITHUB_TOKEN=

# Required to authorize hosted /api/stellar/sync invocations.
CRON_SECRET=

# Local development uses web/.data/reprogate.db when these are omitted.
# A durable remote libSQL database is required on Vercel.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
