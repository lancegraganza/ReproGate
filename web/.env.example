# ReproGate supports local Quickstart and Testnet only. Mainnet is rejected in code.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_REPRO_REGISTRY_CONTRACT_ID=CAH5OSI255VRSJJQVM6JCR77E5C52IB7Y6WCNZYVC3DH7MDSVMRLHMVI
NEXT_PUBLIC_REWARD_VAULT_CONTRACT_ID=CDDE25PTGG2XOTQHJ25CIQRUBJ6I6Q4WLIIWSURLLWP26B5HKABWNU5E

# Optional for higher GitHub API limits and posting the final issue report.
GITHUB_TOKEN=

# Required to authorize hosted /api/stellar/sync invocations.
CRON_SECRET=

# Local development uses web/.data/reprogate.db when these are omitted.
# A durable remote libSQL database is required on Vercel.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Server-only automated reproduction settings. The cron route is Testnet-only.
GEMINI_API_KEY=
# GOOGLE_GEMINI_API_KEY is accepted as a backwards-compatible alias.
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CRON_REPRO_TASK_ID=a6896709-c73d-4aea-a896-c90437dad8fb
CRON_EVIDENCE_AMOUNT_XLM=0.1
CRON_PAYMENT_DESTINATION=
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Current public Google Form field IDs from its published form metadata.
GOOGLE_FORM_RESPONSE_URL=https://docs.google.com/forms/d/e/1FAIpQLSd2Ck13Ju-TeC_XWN6u37yPw3DTO0Tg5IpPFJNccctvckYgqA/formResponse
GOOGLE_FORM_FULL_NAME_FIELD=entry.539509873
GOOGLE_FORM_EMAIL_FIELD=entry.579604623
GOOGLE_FORM_WALLET_FIELD=entry.1006726406
GOOGLE_FORM_SCALE_FIELD=entry.499711501
GOOGLE_FORM_FEEDBACK_FIELD=entry.828139016
